{
  "url": "http://127.0.0.1:{{PORT}}",
  "viewport": { "width": 1280, "height": 720 },
  "assertions": [
    {
      "type": "visible",
      "expect": "Settings",
      "label": "Page heading visible"
    },
    {
      "type": "console_errors",
      "expect": "none",
      "label": "No console errors"
    },
    {
      "type": "network_status",
      "expect": { "failed": "none" },
      "label": "No failed network requests"
    }
  ]
}
